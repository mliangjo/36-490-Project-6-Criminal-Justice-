# w_matches %>%
#   ggplot(aes(x = Year)) +
#   geom_bar(fill = "yellowgreen", na.rm = T) +
#   labs(title = "Bar Plot of Charted WTA Matches Per Year",
#        x = "Year", y = "Count")
#Plots a stacked bar plot of num matches recorded in mens and womens matches per surface type
matches %>%
ggplot(aes(x = factor(Surface), fill = Tour)) + #Use factor for categorical variables
geom_bar(position = "dodge",  na.rm = T) +
labs(title = "Side by Side Bar Plot of Charted Matches Per Surface",
x = "Surface", y = "Count")
library(tidyverse)
# Load Data
## Jeff Sackmann's Match Charting Project
## Licensed use under a Creative Commons Attribution NonCommercial ShareAlike 4.0 International License
## https://github.com/JeffSackmann/tennis_MatchChartingProject
points <- read_csv("98504_MCP_2026_02_08_points.csv.gz")
# More data cleaning and splitting into a stroke delimited form
# ----------------------------- Dictionary --------------------------------
shot_direction <- c('1', '2', '3', '7', '8', '9')
serves <- c('4', '5', '6')
outcomes <- c('*', '#', '@')
errors <- c('n', 'w', 'd', 'x', 'g', '!', 'V', 'e')
fstrokes <- c('f', 'r', 'v', 'o', 'u', 'l', 'h', 'j')
bstrokes <- c('b', 's', 'z', 'p', 'y', 'm', 'i', 'k')
ustrokes <- c('t', 'q')
strokes <- c(fstrokes, bstrokes, ustrokes)
#Makes one list with all characters we care about
all_valid_chars <- c(shot_direction, serves, outcomes, errors, strokes)
# ----------------------------- Clean Encodings --------------------------------
# Input: encoding (str)
# Output: encoding (str)
clean_enc <- function(enc)
{
#Removes anything before a let
enc <- str_replace(enc, ".*c", "")
# Flattens into one string. Coerces into regex pattern [^ stuff] which means "exclude anything not inside the brackets
regex_valid_chars <- paste0("[^", paste0(all_valid_chars, collapse = ""), "]")
#Replace all in the encoding that match the regex code with "". ie remove anything we don't want
return(str_replace_all(enc, regex_valid_chars, ""))
}
#Adds the cleaned columns back to the df
points$cleaned_1st <- clean_enc(points$`1st`)
points$cleaned_2nd <- clean_enc(points$`2nd`)
# ----------------------------- Parse Encodings --------------------------------
#Input Cleaned encoding (str)
#Output: List of encodings (list)
parse_enc <- function(enc)
{
#Handles NA
if(is.na(enc)) return(NA)
#Handles Service Aces and faults
if(nchar(enc) <= 2) return(c(enc))
#Otherwise serve got in, so split it off
serve <- str_sub(enc, start = 1, end = 1)
remainder <- str_sub(enc, start = 2, end = -1)
pattern <- paste0("(?=[", paste0(strokes, collapse = ""), "])") #?[] Regex for look for next
chunks <- str_split(remainder, pattern)[[1]] #Extracts the vector of these letters
return(c(serve, chunks[chunks != ""]))
}
# map is analogous to lapply
points$parsed_1st <- map(points$cleaned_1st, parse_enc)
points$parsed_2nd <- map(points$cleaned_2nd, parse_enc)
# -------------------- Calculate Rally length ---------------------------
rally_length_col <- function(parsed_enc)
{
if(any(is.na(parsed_enc))) return (-1) #Why do we set -1 for an NA?
last_shot <- parsed_enc[length(parsed_enc)]
outcome <- substr(last_shot, nchar(last_shot), nchar(last_shot)) #Gets last char from last shot
num_shots <- length(parsed_enc)
if (outcome %in% errors) return(num_shots - 1) #This is a fault eg. 6n
if (outcome == '#' && num_shots == 1) return (num_shots) #This is an unreturnable serve (special case, but point outcome wise analogous to ace)
if (outcome %in% c('#', '@')) return (num_shots - 1) #Error
if (outcome == '*') return (num_shots) #Winner
return(-10) #Why return -10?
}
#and finally
points$rally_length <- pmax( #Pointwise maximum
map_int(points$parsed_1st, rally_length_col),
map_int(points$parsed_2nd, rally_length_col)
)
# As the statistician, decide what to do with these outlier data
table(points$rally_length)
points %>%
ggplot(aes(x = rally_length, fill = Tour)) +
geom_bar(position = "stack") +
labs(title = "Stacked Bar Plot of Rally Length by Tour",
x = "Rally Length", y = "Count")
points %>%
filter(rally_length >= 0) %>% #Gets rid of -10 and -1 values
ggplot(aes(x = rally_length, fill = Tour)) +
geom_bar(position = "stack") +
labs(title = "Stacked Bar Plot of Rally Length by Tour",
x = "Rally Length", y = "Count")
points %>%
filter(rally_length >= 0) %>%
ggplot(aes(x = rally_length, y = Tour)) +
geom_boxplot(position = "dodge2") +
labs(title = "Side by Side Box Plot of Rally Length by Tour",
x = "Rally Length", y = "Tour")
points %>%
filter(rally_length >= 0, Tour == "ATP") %>% #Gets rid of -10 and -1 values
pull(rally_length) %>% #Only keeps rally length column
summary()
points %>%
filter(rally_length >= 0, Tour == "WTA") %>% #Gets rid of -10 and -1 values
pull(rally_length) %>% #Only keeps rally length column
summary()
View(points)
