#R data science library that packages together numerous packages including dplyr, readr, ggplot2, and tibble. Some optimization improvements and streamlines notation compared to base R functions. https://tidyverse.org/
library(tidyverse)
## Jeff Sackmann's Match Charting Project
## Licensed use under a Creative Commons Attribution NonCommercial ShareAlike 4.0 International License
## https://github.com/JeffSackmann/tennis_MatchChartingProject
#Reads in all of the points datasets
m_points_2009 <- read_csv("https://raw.githubusercontent.com/JeffSackmann/tennis_MatchChartingProject/refs/heads/master/charting-m-points-to-2009.csv")
m_points_2010s <- read_csv("https://raw.githubusercontent.com/JeffSackmann/tennis_MatchChartingProject/refs/heads/master/charting-m-points-2010s.csv")
m_points_2020s <- read_csv("https://raw.githubusercontent.com/JeffSackmann/tennis_MatchChartingProject/refs/heads/master/charting-m-points-2020s.csv")
w_points_2009 <- read_csv("https://raw.githubusercontent.com/JeffSackmann/tennis_MatchChartingProject/refs/heads/master/charting-w-points-to-2009.csv")
w_points_2010s <- read_csv("https://raw.githubusercontent.com/JeffSackmann/tennis_MatchChartingProject/refs/heads/master/charting-w-points-2010s.csv")
w_points_2020s <- read_csv("https://raw.githubusercontent.com/JeffSackmann/tennis_MatchChartingProject/refs/heads/master/charting-w-points-2020s.csv")
#Combines the mens and womens points datasets in one df
m_points <- rbind(m_points_2020s, m_points_2010s, m_points_2009)
w_points <- rbind(w_points_2020s, w_points_2010s, w_points_2009)
#Labels each as ATP or WTA and combines into one big df
m_points$Tour <- "ATP"
w_points$Tour <- "WTA"
points <- rbind(m_points, w_points)
#Reads in all mens and womens match datasets
m_matches <- read_csv("https://raw.githubusercontent.com/JeffSackmann/tennis_MatchChartingProject/refs/heads/master/charting-m-matches.csv")
w_matches <- read_csv("https://raw.githubusercontent.com/JeffSackmann/tennis_MatchChartingProject/refs/heads/master/charting-w-matches.csv")
#Labels each match as ATP or WTA and combines
m_matches$Tour <- "ATP"
w_matches$Tour <- "WTA"
matches <- rbind(m_matches, w_matches)
#Removes these df from the environment
rm(m_points_2009)
rm(m_points_2010s)
rm(m_points_2020s)
rm(w_points_2009)
rm(w_points_2010s)
rm(w_points_2020s)
rm(m_points)
rm(w_points)
#Always good practice to first insoect the shape of the data
head(points, 5) # Head(df, n) displays the first n rows of the dataset
head(matches, 5)
#What did those warnings mean when loading in the matches files?
problems(m_matches)
problems(w_matches)
m_matches[710:711, ] #R indexes matrices using [Rows, Columns]. This command is saying grab grows 710-711, and leaving a number blank means grab all values (cols)
w_matches[1351:1359, ]
table(factor(matches$Surface)) #Produces frequency table with top row Surface name, bottom row counts
#Let's look again at the rows where there is misrecorded data.
# !!! Also consider that the github files sourcing this might change, so don't run this code blindly in the future !!!
warning("Data files may have updated! Rerun problems() to ensure you're only removing bad data!")
m_matches[708:712, ] #Slightly wider range to see around the problem rows
w_matches[1350:1360, ] # Notice the data in row 1360 has a lot of missingness. This may be a problem for specific analyses, but for general cleaning I'm just choosing to throw out rows with incorrect information, not missing information
#c() is the combine/container function. Combines vectors
bad_match_ids <- c(m_matches[709:710, ]$match_id, w_matches[1350:1358, ]$match_id)
matches <- matches %>%
filter(!match_id %in% bad_match_ids) #Set matches to the rows where match_id != one of these bad ones
points <- points %>%
filter(!match_id %in% bad_match_ids) #Maybe not necessary, but convenient for consistency's sake. This is again a decision that that statistician has to make when dealing with imperfect data
## Writing this data into a CSV to save on my local machine
#gz is GZip, which compresses the data a bit more
# Total size of these files is around 25 MB. Uncomment only when you want to save to your machine
# write_csv(matches, "98504_MCP_2026_02_08_matches.csv.gz")
# write_csv(points, "98504_MCP_2026_02_08_points.csv.gz")
#Selects just the year from the full date, and adds that as its own column to the df
matches$Year <- matches$Date %>%
as.character() %>%
as.Date(format = "%Y%m%d") %>%
year()
#%>% is the pipe operator, which basically means pass the last argument forward into the next function. This code can equivallently we expressed as below
#year(as.Date(as.character(m_matches$Date), format = "%Y%m%d"))
#Plots a stacked bar plot of num matches recorded in mens and womens matches per year
matches %>%
ggplot(aes(x = Year, fill = Tour)) +
geom_bar(position = "stack",  na.rm = T) + #Why na.rm? See last code chunk
labs(title = "Stacked Bar Plot of Charted Matches Per Year",
x = "Year", y = "Count")
#Plots a side by side bar plot of num matches recorded in mens and womens matches per year
matches %>%
ggplot(aes(x = Year, fill = Tour)) +
geom_bar(position = "dodge",  na.rm = T) +
labs(title = "Side by Side Bar Plot of Charted Matches Per Year",
x = "Year", y = "Count")
## Code for just ploting ATP or WTA
# m_matches %>%
#   ggplot(aes(x = Year)) +
#   geom_bar(fill = "blueviolet", na.rm = T) +
#   labs(title = "Bar Plot of Charted ATP Matches Per Year",
#        x = "Year", y = "Count")
